# Copy to .env and adjust.
#
# `make run` (a single container) connects to the database named by all of these.
# From inside the container, the host machine is reachable as
# host.docker.internal (Docker Desktop).
#
# `docker compose up` (`make up`) runs its own database and sets POSTGRES_HOST and
# POSTGRES_PORT itself. It uses only POSTGRES_DB, POSTGRES_USER and
# POSTGRES_PASSWORD from here, to create the database; changing the password
# later does not change it in an existing volume. BACKEND_PORT (default 8000) is
# the port the backend is published on.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=tiron
POSTGRES_USER=tiron
POSTGRES_PASSWORD=change-me
# BACKEND_PORT=8000
