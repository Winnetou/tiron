# The frontend for production: the app is built once, and Caddy serves the files,
# passes the backend's routes on to it, and does HTTPS (see Caddyfile). Nothing of the
# dev server (Dockerfile in this directory) is in the image.
FROM node:22-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
# tsc -b, then vite build: the files are in /app/dist
RUN npm run build

FROM caddy:2.11-alpine

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

# 80: HTTP (and the challenge for the certificate); 443: HTTPS, over TCP and UDP (HTTP/3)
EXPOSE 80 443 443/udp
