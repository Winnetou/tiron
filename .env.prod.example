# The settings of a production deployment (docker-compose.prod.yml).
#
#   cp .env.prod.example .env.prod      and fill it in; .env.prod is not committed.
#   Keep it readable by its owner only: chmod 600 .env.prod
#
# There is no database in this compose file: it is PostgreSQL in Google Cloud.

# The database. With Cloud SQL on a private IP, POSTGRES_HOST is that IP (the VM must
# be in the same VPC). The user has no right to change the schema: the tables are
# created by hand beforehand (app/persistence/schema.py), PROD is always true here.
POSTGRES_HOST=10.0.0.3
# POSTGRES_PORT=5432
POSTGRES_DB=tiron
POSTGRES_USER=tiron
POSTGRES_PASSWORD=change-me
# TLS to the database: require, verify-ca or verify-full, and the CA certificate for
# the last two (a file that must be mounted into the containers). Unset: libpq's
# default (`prefer`). Cloud SQL on a private IP is inside the VPC.
# POSTGRES_SSLMODE=require
# POSTGRES_SSLROOTCERT=

# The RabbitMQ broker, used by the Celery worker. Not published, but it has no
# default password here: set one.
# RABBITMQ_USER=tiron
RABBITMQ_PASSWORD=change-me-too

# The address Caddy serves, and the log level.
#
# Without a domain it is plain HTTP on port 80, with no certificate (the default).
# With a domain, Caddy gets a Let's Encrypt certificate for it by itself and renews it
# before it runs out, and sends HTTP to HTTPS. The domain must point at this VM (an A
# record for its static IP), and the ports 80 and 443 must be open to the internet.
# SITE_ADDRESS=tiron.example.com
# LOG_LEVEL=INFO
